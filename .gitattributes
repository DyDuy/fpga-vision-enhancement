* text=auto eol=lf
*.sv text eol=lf
*.v text eol=lf
*.scala text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.sof binary
*.rbf binary

# Preserve trailing spaces in Qsys serialized bonusData CDATA metadata.
/hardware/qsys/*.qsys whitespace=-blank-at-eol
