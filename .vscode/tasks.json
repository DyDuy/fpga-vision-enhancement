{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HPS: build all",
      "type": "process",
      "command": "bash",
      "args": [
        "software/hps/build.sh",
        "all"
      ],
      "windows": {
        "command": "wsl.exe",
        "args": [
          "-d",
          "Ubuntu",
          "--cd",
          "${workspaceFolder}",
          "--exec",
          "bash",
          "software/hps/build.sh",
          "all"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "HPS: build vga_simple_display",
      "type": "process",
      "command": "bash",
      "args": [
        "software/hps/build.sh",
        "vga_simple_display"
      ],
      "windows": {
        "command": "wsl.exe",
        "args": [
          "-d",
          "Ubuntu",
          "--cd",
          "${workspaceFolder}",
          "--exec",
          "bash",
          "software/hps/build.sh",
          "vga_simple_display"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "DE1: build validated for Linaro",
      "type": "process",
      "command": "bash",
      "args": [
        "software/hps/de1.sh",
        "build"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/software/hps/de1.ps1",
          "build"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "DE1: push new release",
      "type": "process",
      "command": "bash",
      "args": [
        "software/hps/de1.sh",
        "push"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/software/hps/de1.ps1",
          "push"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      }
    },
    {
      "label": "DE1: push and run RGB24 image",
      "type": "process",
      "command": "bash",
      "args": [
        "software/hps/de1.sh",
        "push",
        "--run",
        "${input:de1Rgb24Input}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/software/hps/de1.ps1",
          "push",
          "--run",
          "${input:de1Rgb24Input}"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "de1Rgb24Input",
      "type": "promptString",
      "description": "RGB24 hex: project-relative path, WSL path, or Windows absolute path",
      "default": "input_image.hex"
    }
  ]
}
